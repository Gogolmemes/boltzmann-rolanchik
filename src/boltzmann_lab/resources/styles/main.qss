QMainWindow {
    background: #f8fafc;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    margin-top: 10px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QPushButton {
    min-height: 28px;
    padding: 3px 8px;
}

QSpinBox,
QDoubleSpinBox,
QComboBox {
    min-height: 25px;
}